{
    "name": "aether-mcp-server",
    "version": "3.0.1",
    "description": "Aether MCP Server - AI Browser Controller",
    "main": "dist/index.js",
    "bin": {
        "aether-mcp-server": "dist/index.js"
    },
    "files": [
        "dist/",
        "skills/",
        "extension/",
        "!dist/agent.js",
        "!dist/policy-client.js",
        "!dist/trace-recorder.js",
        "!dist/test/",
        "README.md"
    ],
    "scripts": {
        "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
        "build": "tsc",
        "postbuild": "node -e \"const f=require('fs');const c=f.readFileSync('dist/index.js','utf8');f.writeFileSync('dist/index.js','#!/usr/bin/env node\\n'+c.replace('#!/usr/bin/env node\\n',''))\"",
        "start": "ts-node src/index.ts",
        "dev": "nodemon src/index.ts",
        "typecheck": "tsc --noEmit",
        "pretest": "npm run build",
        "test": "node --test \"dist/test/*.test.js\"",
        "prepublishOnly": "npm run build"
    },
    "engines": {
        "node": ">=20"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.29.0",
        "express": "^5.2.1",
        "patchright-core": "^1.64.3",
        "ws": "^8.18.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/express": "^5.0.0",
        "@types/node": "^22.5.5",
        "@types/ws": "^8.5.12",
        "nodemon": "^3.1.4",
        "ts-node": "^10.9.2",
        "typescript": "^5.6.2"
    }
}
