{
  "manifest_version": 3,
  "name": "Aether Browser Bridge",
  "version": "0.1.0",
  "description": "Gives Aether MCP control of dedicated tabs in this existing Chromium browser.",
  "permissions": ["alarms", "debugger", "tabs", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Aether Browser Bridge",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:8766"
  }
}
