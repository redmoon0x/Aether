{
  "manifest_version": 3,
  "name": "Aether Browser Bridge",
  "version": "1.0.0",
  "description": "Lets Aether drive its own tabs in this browser, with your existing logins and extensions.",
  "minimum_chrome_version": "116",
  "permissions": ["alarms", "debugger", "tabs", "tabGroups", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Aether Browser Bridge",
    "default_popup": "popup.html"
  }
}
